      "title": "QoE Per Site",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sentinel-clickhouse"
          },
          "rawSql": "SELECT\n  ts AS time,\n  site AS metric,\n  score AS __value\nFROM site_qoe_minute\nWHERE\n  $__timeFilter(ts)\n  AND ($zone = 'All' OR splitByChar('-', site)[1] = $zone)\n  AND ($pop = 'All' OR splitByChar('-', site)[2] = $pop)\nORDER BY ts",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "sentinel-clickhouse"
      },
