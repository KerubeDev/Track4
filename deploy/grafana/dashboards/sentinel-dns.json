        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sentinel-clickhouse"
          },
          "rawSql": "SELECT\n  toStartOfInterval(ts, INTERVAL 1 Minute) AS time,\n  site AS metric,\n  avg(nxdomain_rate) AS __value\nFROM site_qoe_minute\nWHERE\n  $__timeFilter(ts)\n  AND ($zone = 'All' OR splitByChar('-', site)[1] = $zone)\n  AND ($pop = 'All' OR splitByChar('-', site)[2] = $pop)\nGROUP BY time, site\nORDER BY time",
