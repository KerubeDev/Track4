      "title": "p50 / p95 Latency",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "sentinel-clickhouse"
          },
          "rawSql": "SELECT\n  toStartOfInterval(ts, INTERVAL 1 Minute) AS time,\n  quantile(0.50)(latency_ms) AS \"p50\",\n  quantile(0.95)(latency_ms) AS \"p95\"\nFROM dns_events_raw\nWHERE\n  $__timeFilter(ts)\n  AND ($zone = 'All' OR zone_id = $zone)\n  AND ($pop = 'All' OR pop_id = $pop)\nGROUP BY time\nORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
