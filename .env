# =============================================================================
# .env — Sentinel-DNS Track4 compose configuration
# Issue #15 (S2-T5) — Docker compose + idempotent provision
#
# All services read these variables. Defaults are chosen for the full demo
# stack (attack episodes + visual dashboards).
# =============================================================================

# --- Replay -----------------------------------------------------------------
# Emulator replay rate (multiplier over real-time).  x20 = 20x faster.
REPLAY_RATE=20

# Fixed random seed for reproducible attack episodes and zone/latency synthesis.
DEMO_SEED=42

# --- ClickHouse -------------------------------------------------------------
CLICKHOUSE_DB=sentinel_dns
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Grafana ----------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=sentinel

# --- Wazuh ------------------------------------------------------------------
INDEXER_USERNAME=admin
INDEXER_PASSWORD=admin

# --- Kafka (KRaft) ----------------------------------------------------------
KAFKA_CLUSTER_ID=multiline-sentinel-dns-cluster
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093

# --- QVAC -------------------------------------------------------------------
# QVAC runtime image and local API. The image must be built/preloaded before
# running compose; this is deliberately not a fallback mock server.
QVAC_IMAGE=sentinel-qvac-local:preloaded
QVAC_CLI_VERSION=0.13.0
QVAC_PORT=11434
QVAC_MODEL=QWEN3_1_7B_INST_Q4
QVAC_TIMEOUT_SECONDS=30
QVAC_URL=http://host.docker.internal:11434
