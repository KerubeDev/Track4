# SHIELD local configuration
REPLAY_RATE=20
DEMO_SEED=42

CLICKHOUSE_DB=sentinel_dns
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

KAFKA_CLUSTER_ID=shield-local-kraft-cluster
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_TOPIC_RETENTION_MS=3600000

# QVAC is expected to run on the host by default.
QVAC_PORT=11434
QVAC_MODEL=QWEN3_1_7B_INST_Q4
QVAC_TIMEOUT_SECONDS=30
QVAC_URL=http://host.docker.internal:11434

# Optional containerized QVAC profile.
QVAC_IMAGE=shield-qvac-local:preloaded
QVAC_CLI_VERSION=0.13.0

# Detection thresholds.
FILTER_WINDOW_SECONDS=60
FILTER_MIN_WINDOW_EVENTS=5
FILTER_NXDOMAIN_RATIO=0.6
FILTER_ENTROPY=3.5
FILTER_LONG_LABEL=40
FILTER_RARITY=0.2
FILTER_BEACON_VARIANCE=4
FILTER_BEACON_MIN_GAP_SECONDS=5
