{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "quirk Review Fix Plan Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "pr", "review", "sourceReview", "items"],
  "properties": {
    "status": { "type": "string", "const": "planned" },
    "pr": { "type": "string", "minLength": 1 },
    "review": { "type": "string", "minLength": 1 },
    "sourceReview": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis", "severity", "finding", "fix", "validate", "scopeGuard"],
        "properties": {
          "axis": { "type": "string", "enum": ["Standards", "Spec"] },
          "severity": { "type": "string", "enum": ["blocker", "required", "advisory"] },
          "finding": { "type": "string", "minLength": 1 },
          "fix": { "type": "string", "minLength": 1 },
          "validate": { "type": "string", "minLength": 1 },
          "scopeGuard": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
